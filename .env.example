# Sample environment file.
#
# Copy this to `.env` (which is gitignored) and fill in the values your
# interviewer gives you. The app loads `.env` automatically on startup.
#
#   cp .env.example .env
#
# The S3 bucket and AWS access key/secret will be provided to you. They are
# read-only and scoped to this exercise.

# --- Postgres book-keeping store ---
# The default below works out of the box with `docker compose up -d db`.
# DATABASE_URL=postgresql://dataflow:dataflow@localhost:5432/dataflow

# --- S3 source data ---
# Bucket + prefix where the source datasets (events.json, users.json) live.
S3_BUCKET=<provided-by-interviewer>
S3_PREFIX=dataflow-interview
AWS_REGION=us-west-2

# AWS credentials (provided by interviewer). Both naming styles are accepted:
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or AWS_ACCESS_KEY / AWS_SECRET_KEY.
AWS_ACCESS_KEY=<provided-by-interviewer>
AWS_SECRET_KEY=<provided-by-interviewer>
